{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "いろとりスタジオ",
  "version": "0.1.0",
  "identifier": "com.takataka.irodoristudio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "いろとりスタジオ — 声のデータベース＆読み上げ保存",
        "width": 960,
        "height": 820,
        "minWidth": 780,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
